{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/watchout/agent-memory/schemas/kusabi-continuity-interruption-e2e-v1.schema.json",
  "title": "Kusabi continuity interruption E2E evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "exact_base",
    "constraints",
    "backends",
    "rows",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": "kusabi-continuity-interruption-e2e/v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "exact_base": { "$ref": "#/$defs/exact_base" },
    "constraints": { "$ref": "#/$defs/constraints" },
    "backends": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/backend" }
    },
    "rows": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/row" }
    },
    "summary": { "$ref": "#/$defs/summary" }
  },
  "$defs": {
    "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "host": { "type": "string", "enum": ["codex", "claude_code", "gemini_cli"] },
    "scenario": {
      "type": "string",
      "enum": [
        "pre_output",
        "post_visible_pre_capture",
        "inflight_tool",
        "post_file_write_pre_commit",
        "temporary_database_outage",
        "capture_crash_restart",
        "identity_mismatch"
      ]
    },
    "backend_kind": { "type": "string", "enum": ["json", "sqlite", "postgres"] },
    "exact_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": { "$ref": "#/$defs/sha1" },
        "tree": { "$ref": "#/$defs/sha1" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hosts",
        "scenarios",
        "startup_timeout_seconds_max",
        "recovery_output_tokens_max",
        "recovery_output_bytes_max"
      ],
      "properties": {
        "hosts": { "const": ["codex", "claude_code", "gemini_cli"] },
        "scenarios": {
          "const": [
            "pre_output",
            "post_visible_pre_capture",
            "inflight_tool",
            "post_file_write_pre_commit",
            "temporary_database_outage",
            "capture_crash_restart",
            "identity_mismatch"
          ]
        },
        "startup_timeout_seconds_max": { "const": 7 },
        "recovery_output_tokens_max": { "const": 1800 },
        "recovery_output_bytes_max": { "const": 8192 }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "backend", "isolated", "cleanup"],
      "properties": {
        "host": { "$ref": "#/$defs/host" },
        "backend": { "$ref": "#/$defs/backend_kind" },
        "isolated": { "const": true },
        "cleanup": { "const": "PASS" }
      },
      "allOf": [
        {
          "if": { "properties": { "host": { "const": "codex" } }, "required": ["host"] },
          "then": { "properties": { "backend": { "const": "json" } } }
        },
        {
          "if": { "properties": { "host": { "const": "claude_code" } }, "required": ["host"] },
          "then": { "properties": { "backend": { "const": "sqlite" } } }
        },
        {
          "if": { "properties": { "host": { "const": "gemini_cli" } }, "required": ["host"] },
          "then": { "properties": { "backend": { "const": "postgres" } } }
        }
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "host",
        "scenario",
        "backend",
        "result",
        "expected",
        "actual",
        "duration_ms",
        "startup_ms",
        "recovery_output_bytes",
        "recovery_output_tokens",
        "input_sha256",
        "output_sha256",
        "interrupted_process_id_sha256",
        "fresh_process_id_sha256",
        "interrupted_invocation_id_sha256",
        "fresh_invocation_id_sha256",
        "distinct_process_identity",
        "distinct_invocation_identity",
        "sentinel_recovered",
        "missing_capture_detected",
        "external_readback_performed",
        "ambiguous_effect_retry_count",
        "duplicate_external_side_effect_count",
        "replay_duplicate_event_count",
        "identity_mismatch_rejected",
        "private_or_protected_capture_count",
        "unknown_field_persisted_count",
        "raw_absolute_path_match_count",
        "negative_fixture_result"
      ],
      "properties": {
        "row_id": { "type": "string", "pattern": "^(codex|claude_code|gemini_cli):(pre_output|post_visible_pre_capture|inflight_tool|post_file_write_pre_commit|temporary_database_outage|capture_crash_restart|identity_mismatch)$" },
        "host": { "$ref": "#/$defs/host" },
        "scenario": { "$ref": "#/$defs/scenario" },
        "backend": { "$ref": "#/$defs/backend_kind" },
        "result": { "const": "PASS" },
        "expected": { "type": "string", "minLength": 1 },
        "actual": { "type": "string", "enum": ["recovered", "identity_rejected"] },
        "duration_ms": { "type": "integer", "minimum": 0, "maximum": 30000 },
        "startup_ms": { "type": "integer", "minimum": 0, "maximum": 7000 },
        "recovery_output_bytes": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "recovery_output_tokens": { "type": "integer", "minimum": 1, "maximum": 1800 },
        "input_sha256": { "$ref": "#/$defs/sha256" },
        "output_sha256": { "$ref": "#/$defs/sha256" },
        "interrupted_process_id_sha256": { "$ref": "#/$defs/sha256" },
        "fresh_process_id_sha256": { "$ref": "#/$defs/sha256" },
        "interrupted_invocation_id_sha256": { "$ref": "#/$defs/sha256" },
        "fresh_invocation_id_sha256": { "$ref": "#/$defs/sha256" },
        "distinct_process_identity": { "const": true },
        "distinct_invocation_identity": { "const": true },
        "sentinel_recovered": { "type": "boolean" },
        "missing_capture_detected": { "type": "boolean" },
        "external_readback_performed": { "type": "boolean" },
        "ambiguous_effect_retry_count": { "const": 0 },
        "duplicate_external_side_effect_count": { "const": 0 },
        "replay_duplicate_event_count": { "const": 0 },
        "identity_mismatch_rejected": { "type": "boolean" },
        "private_or_protected_capture_count": { "const": 0 },
        "unknown_field_persisted_count": { "const": 0 },
        "raw_absolute_path_match_count": { "const": 0 },
        "negative_fixture_result": { "const": "PASS" }
      },
      "allOf": [
        {
          "if": { "properties": { "scenario": { "const": "identity_mismatch" } }, "required": ["scenario"] },
          "then": {
            "properties": {
              "actual": { "const": "identity_rejected" },
              "identity_mismatch_rejected": { "const": true },
              "sentinel_recovered": { "const": false }
            }
          },
          "else": {
            "properties": {
              "actual": { "const": "recovered" },
              "identity_mismatch_rejected": { "const": false },
              "sentinel_recovered": { "const": true }
            }
          }
        },
        {
          "if": { "properties": { "scenario": { "const": "post_visible_pre_capture" } }, "required": ["scenario"] },
          "then": { "properties": { "missing_capture_detected": { "const": true } } }
        },
        {
          "if": { "properties": { "scenario": { "const": "post_file_write_pre_commit" } }, "required": ["scenario"] },
          "then": { "properties": { "external_readback_performed": { "const": true } } }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_rows",
        "passed_rows",
        "failed_rows",
        "sentinel_capture_and_recovery_hosts",
        "recovered_latest_durable_objective_hosts",
        "fresh_process_identity_rows",
        "fresh_invocation_identity_rows",
        "temporary_database_outage_recovery_hosts",
        "capture_crash_restart_recovery_hosts",
        "identity_mismatch_fail_closed_hosts",
        "ambiguous_effect_retry_without_resolution_count",
        "duplicate_external_side_effect_count",
        "replay_duplicate_event_count",
        "private_or_protected_capture_count",
        "unknown_field_persisted_count",
        "raw_absolute_path_match_count",
        "production_effect_count",
        "temporary_fixture_cleanup"
      ],
      "properties": {
        "expected_rows": { "const": 21 },
        "passed_rows": { "const": 21 },
        "failed_rows": { "const": 0 },
        "sentinel_capture_and_recovery_hosts": { "const": 3 },
        "recovered_latest_durable_objective_hosts": { "const": 3 },
        "fresh_process_identity_rows": { "const": 21 },
        "fresh_invocation_identity_rows": { "const": 21 },
        "temporary_database_outage_recovery_hosts": { "const": 3 },
        "capture_crash_restart_recovery_hosts": { "const": 3 },
        "identity_mismatch_fail_closed_hosts": { "const": 3 },
        "ambiguous_effect_retry_without_resolution_count": { "const": 0 },
        "duplicate_external_side_effect_count": { "const": 0 },
        "replay_duplicate_event_count": { "const": 0 },
        "private_or_protected_capture_count": { "const": 0 },
        "unknown_field_persisted_count": { "const": 0 },
        "raw_absolute_path_match_count": { "const": 0 },
        "production_effect_count": { "const": 0 },
        "temporary_fixture_cleanup": { "const": "PASS" }
      }
    }
  }
}
