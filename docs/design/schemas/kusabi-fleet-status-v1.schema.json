{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/watchout/agent-memory/blob/main/docs/design/schemas/kusabi-fleet-status-v1.schema.json",
  "title": "Kusabi fleet status snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "generated_at",
    "manifest",
    "window",
    "summary",
    "targets",
    "alerts",
    "next_action"
  ],
  "properties": {
    "schema_version": { "const": "kusabi-fleet-status/v1" },
    "snapshot_id": { "type": "string", "format": "uuid" },
    "generated_at": { "type": "string", "format": "date-time" },
    "manifest": { "$ref": "#/$defs/manifest" },
    "window": { "$ref": "#/$defs/window" },
    "summary": { "$ref": "#/$defs/summary" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    },
    "alerts": {
      "type": "array",
      "items": { "$ref": "#/$defs/alert" }
    },
    "next_action": { "$ref": "#/$defs/nextActionOrNone" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "boundedId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_id", "version", "manifest_sha256", "target_count"],
      "properties": {
        "manifest_id": { "$ref": "#/$defs/boundedId" },
        "version": { "type": "integer", "minimum": 1 },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "target_count": { "type": "integer", "minimum": 1 }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "ended_at"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_count",
        "healthy_count",
        "degraded_count",
        "failed_count",
        "stale_count",
        "not_observed_count",
        "drifted_count",
        "open_p0_count",
        "open_p1_count",
        "open_p2_count",
        "open_p3_count",
        "exact_observation_rate",
        "durable_evidence_rate"
      ],
      "properties": {
        "target_count": { "type": "integer", "minimum": 1 },
        "healthy_count": { "type": "integer", "minimum": 0 },
        "degraded_count": { "type": "integer", "minimum": 0 },
        "failed_count": { "type": "integer", "minimum": 0 },
        "stale_count": { "type": "integer", "minimum": 0 },
        "not_observed_count": { "type": "integer", "minimum": 0 },
        "drifted_count": { "type": "integer", "minimum": 0 },
        "open_p0_count": { "type": "integer", "minimum": 0 },
        "open_p1_count": { "type": "integer", "minimum": 0 },
        "open_p2_count": { "type": "integer", "minimum": 0 },
        "open_p3_count": { "type": "integer", "minimum": 0 },
        "exact_observation_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "durable_evidence_rate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "project", "host_runtime", "workspace_sha256"],
      "properties": {
        "agent_id": { "$ref": "#/$defs/boundedId" },
        "project": { "$ref": "#/$defs/boundedId" },
        "host_runtime": { "enum": ["codex", "claude_code", "gemini_cli"] },
        "workspace_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "buildIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "tree_sha", "artifact_sha256", "adapter_version"],
      "properties": {
        "commit_sha": { "$ref": "#/$defs/gitSha" },
        "tree_sha": { "$ref": "#/$defs/gitSha" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "adapter_version": { "$ref": "#/$defs/boundedId" }
      }
    },
    "configurationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_sha256", "trust_fingerprint_sha256", "binding_source_ref_sha256"],
      "properties": {
        "config_sha256": { "$ref": "#/$defs/sha256" },
        "trust_fingerprint_sha256": { "$ref": "#/$defs/sha256" },
        "binding_source_ref_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "storageIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "binding_sha256"],
      "properties": {
        "backend": { "enum": ["sqlite", "postgres"] },
        "binding_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "deploymentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "configuration", "storage"],
      "properties": {
        "build": { "$ref": "#/$defs/buildIdentity" },
        "configuration": { "$ref": "#/$defs/configurationIdentity" },
        "storage": { "$ref": "#/$defs/storageIdentity" }
      }
    },
    "observedDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deployment", "last_event_id", "last_event_at", "evidence_delivery"],
      "properties": {
        "deployment": { "$ref": "#/$defs/deploymentIdentity" },
        "last_event_id": { "type": "string", "format": "uuid" },
        "last_event_at": { "type": "string", "format": "date-time" },
        "evidence_delivery": { "enum": ["durable", "emergency_only", "failed"] }
      }
    },
    "stateReason": {
      "enum": [
        "privacy_violation",
        "runtime_failure",
        "evidence_sink_failure",
        "build_drift",
        "configuration_drift",
        "binding_drift",
        "storage_drift",
        "no_observation",
        "stale_observation",
        "repeated_degradation",
        "latest_recovery_degraded"
      ]
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator_sha256", "content_sha256"],
      "properties": {
        "kind": { "enum": ["local_store", "central_store", "run", "github", "aun", "stderr_emergency"] },
        "locator_sha256": { "$ref": "#/$defs/sha256" },
        "content_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_key",
        "identity",
        "state",
        "state_reasons",
        "expected",
        "observed",
        "last_seen_at",
        "stale_after_seconds",
        "event_count",
        "consecutive_degraded",
        "maintenance_active",
        "evidence_refs"
      ],
      "properties": {
        "target_key": { "$ref": "#/$defs/sha256" },
        "identity": { "$ref": "#/$defs/identity" },
        "state": { "enum": ["healthy", "degraded", "failed", "stale", "not_observed", "drifted"] },
        "state_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stateReason" }
        },
        "expected": { "$ref": "#/$defs/deploymentIdentity" },
        "observed": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/observedDeployment" }
          ]
        },
        "last_seen_at": { "type": ["string", "null"], "format": "date-time" },
        "stale_after_seconds": { "type": "integer", "minimum": 60 },
        "event_count": { "type": "integer", "minimum": 0 },
        "consecutive_degraded": { "type": "integer", "minimum": 0 },
        "maintenance_active": { "type": "boolean" },
        "evidence_refs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceRef" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "not_observed" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "observed": { "const": null },
              "last_seen_at": { "const": null },
              "event_count": { "const": 0 },
              "state_reasons": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "contains": { "const": "no_observation" },
                "minContains": 1
              }
            }
          },
          "else": {
            "properties": {
              "observed": { "$ref": "#/$defs/observedDeployment" },
              "last_seen_at": { "type": "string", "format": "date-time" },
              "event_count": { "type": "integer", "minimum": 1 }
            }
          }
        },
        {
          "if": {
            "properties": { "state": { "const": "healthy" } },
            "required": ["state"]
          },
          "then": {
            "properties": {
              "state_reasons": { "type": "array", "maxItems": 0 },
              "observed": {
                "type": "object",
                "properties": { "evidence_delivery": { "const": "durable" } }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "state": { "enum": ["degraded", "failed", "stale", "drifted"] } },
            "required": ["state"]
          },
          "then": {
            "properties": { "state_reasons": { "type": "array", "minItems": 1 } }
          }
        }
      ]
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_agent_id",
        "active_function",
        "action",
        "deliver_via",
        "exact_input_refs",
        "scope",
        "deliverable",
        "completion_evidence",
        "blocking"
      ],
      "properties": {
        "actor_agent_id": { "$ref": "#/$defs/boundedId" },
        "active_function": { "$ref": "#/$defs/boundedId" },
        "action": { "type": "string", "minLength": 1, "maxLength": 512 },
        "deliver_via": { "type": "string", "minLength": 1, "maxLength": 128 },
        "exact_input_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "scope": { "type": "string", "minLength": 1, "maxLength": 256 },
        "deliverable": { "type": "string", "minLength": 1, "maxLength": 256 },
        "completion_evidence": { "type": "string", "minLength": 1, "maxLength": 512 },
        "blocking": { "type": "boolean" }
      }
    },
    "nextActionOrNone": {
      "oneOf": [
        { "const": "none" },
        { "$ref": "#/$defs/nextAction" }
      ]
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alert_id",
        "severity",
        "code",
        "target_key",
        "first_seen_at",
        "last_seen_at",
        "occurrence_count",
        "fingerprint_sha256",
        "status",
        "evidence_refs",
        "next_action"
      ],
      "properties": {
        "alert_id": { "type": "string", "format": "uuid" },
        "severity": { "enum": ["P0", "P1", "P2", "P3"] },
        "code": {
          "enum": [
            "privacy_violation",
            "destructive_effect",
            "data_loss_or_corruption",
            "false_acceptance",
            "runtime_failure",
            "build_drift",
            "configuration_drift",
            "binding_drift",
            "storage_drift",
            "evidence_sink_failure",
            "not_observed",
            "stale_observation",
            "repeated_degradation",
            "isolated_degradation",
            "performance_warning"
          ]
        },
        "target_key": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "first_seen_at": { "type": "string", "format": "date-time" },
        "last_seen_at": { "type": "string", "format": "date-time" },
        "occurrence_count": { "type": "integer", "minimum": 1 },
        "fingerprint_sha256": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["open", "acknowledged", "resolved", "suppressed"] },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceRef" }
        },
        "next_action": { "$ref": "#/$defs/nextActionOrNone" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "enum": ["privacy_violation", "destructive_effect", "data_loss_or_corruption", "false_acceptance"]
              }
            },
            "required": ["code"]
          },
          "then": {
            "properties": {
              "severity": { "const": "P0" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": ["privacy_violation", "destructive_effect", "data_loss_or_corruption", "false_acceptance"]
              },
              "status": { "enum": ["open", "acknowledged"] }
            },
            "required": ["code", "status"]
          },
          "then": {
            "properties": {
              "next_action": {
                "allOf": [
                  { "$ref": "#/$defs/nextAction" },
                  { "type": "object", "properties": { "blocking": { "const": true } } }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "enum": ["open", "acknowledged"] } },
            "required": ["status"]
          },
          "then": {
            "properties": { "next_action": { "$ref": "#/$defs/nextAction" } }
          }
        },
        {
          "if": {
            "properties": {
              "next_action": {
                "type": "object",
                "properties": { "blocking": { "const": true } },
                "required": ["blocking"]
              }
            }
          },
          "then": {
            "properties": { "severity": { "enum": ["P0", "P1"] } }
          }
        }
      ]
    }
  }
}
